.terraform_base:
  before_script:
    - |
      if [ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
        echo "GOOGLE_APPLICATION_CREDENTIALS is not set"
        exit 1
      fi
      if [ ! -s "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
        echo "Google credentials file is missing or empty"
        exit 1
      fi
      echo "Google credentials file is available"
